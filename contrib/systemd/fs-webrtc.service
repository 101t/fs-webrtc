# Bare-metal install next to FreeSWITCH (see docs/deployment.md):
#   sudo install -m 0755 fs-webrtc /usr/local/bin/
#   sudo mkdir -p /usr/local/share/fs-webrtc && sudo cp -r web/dist /usr/local/share/fs-webrtc/web
#   sudo install -m 0600 .env /etc/fs-webrtc.env          # fill it in first
#   sudo cp contrib/systemd/fs-webrtc.service /etc/systemd/system/
#   sudo systemctl enable --now fs-webrtc
[Unit]
Description=fs-webrtc - private voice and video calls over FreeSWITCH
After=network-online.target freeswitch.service
Wants=network-online.target

[Service]
DynamicUser=true
EnvironmentFile=/etc/fs-webrtc.env
Environment=FSW_LISTEN=127.0.0.1:8090
Environment=FSW_WEB_DIR=/usr/local/share/fs-webrtc/web
Environment=FSW_DATABASE_URL=sqlite:///var/lib/fs-webrtc/fs-webrtc.db
StateDirectory=fs-webrtc
WorkingDirectory=/var/lib/fs-webrtc
ExecStart=/usr/local/bin/fs-webrtc
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
