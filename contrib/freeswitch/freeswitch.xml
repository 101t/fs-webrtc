<?xml version="1.0"?>
<!--
  Complete FreeSWITCH configuration for fs-webrtc. It replaces the stock "vanilla" config:
  there are no default users, no default passwords and no PSTN routes.

  * Users and call routing come from fs-webrtc over mod_xml_curl: only registered accounts
    exist, and only mutual contacts can call each other.
  * SIP is reachable only over WebSocket on loopback (127.0.0.1:5066); fs-webrtc relays browsers
    to it at /sip. Plain SIP listens on 127.0.0.1:5090 only.
  * Media (DTLS-SRTP, ICE) flows browser <-> FreeSWITCH <-> browser on UDP 16384-16584.

  Environment variables (Docker Compose passes them from .env):
    FSW_FREESWITCH_SECRET  shared with fs-webrtc: xml_curl and event socket password (required)
    FSW_EXT_IP             public IP announced for media, or stun:<server>[:port] to discover it
-->
<document type="freeswitch/xml">
  <X-PRE-PROCESS cmd="env-set" data="fsw_secret=$FSW_FREESWITCH_SECRET"/>
  <X-PRE-PROCESS cmd="env-set" data="fsw_ext_ip=$FSW_EXT_IP"/>

  <section name="configuration" description="Various Configuration">
    <configuration name="switch.conf" description="Core Configuration">
      <settings>
        <param name="loglevel" value="info"/>
        <param name="colorize-console" value="false"/>
        <param name="max-sessions" value="1000"/>
        <param name="sessions-per-second" value="30"/>
        <!-- Open this UDP range in your firewall. 4 ports per video call, 2 per audio call. -->
        <param name="rtp-start-port" value="16384"/>
        <param name="rtp-end-port" value="16584"/>
        <param name="rtp-enable-zrtp" value="false"/>
      </settings>
    </configuration>

    <configuration name="modules.conf" description="Modules">
      <modules>
        <load module="mod_console"/>
        <load module="mod_logfile"/>
        <load module="mod_xml_curl"/>
        <load module="mod_event_socket"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_sofia"/>
        <load module="mod_opus"/>
      </modules>
    </configuration>

    <configuration name="opus.conf" description="Opus Codec">
      <settings>
        <param name="use-vbr" value="1"/>
        <param name="complexity" value="10"/>
      </settings>
    </configuration>

    <configuration name="console.conf" description="Console Logger">
      <mappings>
        <map name="all" value="console,debug,info,notice,warning,err,crit,alert"/>
      </mappings>
      <settings>
        <param name="colorize" value="false"/>
        <param name="loglevel" value="info"/>
      </settings>
    </configuration>

    <!-- The image runs FreeSWITCH without a console; this puts the log on `docker logs`. -->
    <configuration name="logfile.conf" description="File Logging">
      <settings>
        <param name="rotate-on-hup" value="false"/>
      </settings>
      <profiles>
        <profile name="default">
          <settings>
            <param name="logfile" value="/dev/stdout"/>
            <param name="rollover" value="0"/>
          </settings>
          <mappings>
            <map name="all" value="info,notice,warning,err,crit,alert"/>
          </mappings>
        </profile>
      </profiles>
    </configuration>

    <configuration name="xml_curl.conf" description="cURL XML Gateway">
      <bindings>
        <binding name="fs-webrtc">
          <param name="gateway-url" value="http://127.0.0.1:8090/freeswitch/xml" bindings="directory|dialplan"/>
          <param name="gateway-credentials" value="freeswitch:$${fsw_secret}"/>
          <param name="auth-scheme" value="basic"/>
          <param name="timeout" value="5"/>
        </binding>
      </bindings>
    </configuration>

    <!-- For fs_cli and the container healthcheck only; fs-webrtc does not use it.
         Not the default 8021, so it can run next to another FreeSWITCH on the same host. -->
    <configuration name="event_socket.conf" description="Socket Client">
      <settings>
        <param name="listen-ip" value="127.0.0.1"/>
        <param name="listen-port" value="8031"/>
        <param name="password" value="$${fsw_secret}"/>
        <param name="apply-inbound-acl" value="loopback.auto"/>
      </settings>
    </configuration>

    <configuration name="sofia.conf" description="sofia Endpoint">
      <global_settings>
        <param name="log-level" value="0"/>
      </global_settings>
      <profiles>
        <profile name="webrtc">
          <settings>
            <param name="user-agent-string" value="fs-webrtc"/>
            <param name="context" value="webrtc"/>
            <param name="dialplan" value="XML"/>
            <param name="sip-ip" value="127.0.0.1"/>
            <param name="sip-port" value="5090"/>
            <param name="ws-binding" value="127.0.0.1:5066"/>
            <param name="rtp-ip" value="$${local_ip_v4}"/>
            <param name="ext-rtp-ip" value="$${fsw_ext_ip}"/>
            <param name="auth-calls" value="true"/>
            <param name="challenge-realm" value="auto_from"/>
            <param name="nonce-ttl" value="60"/>
            <param name="manage-presence" value="false"/>
            <param name="inbound-codec-prefs" value="OPUS,PCMU,PCMA,VP8"/>
            <param name="outbound-codec-prefs" value="OPUS,PCMU,PCMA,VP8"/>
            <param name="inbound-codec-negotiation" value="generous"/>
            <!-- Which browser ICE candidates to use, in order: public first, then private
                 addresses so LAN-only and same-network setups work too. -->
            <param name="apply-candidate-acl" value="wan_v4.auto"/>
            <param name="apply-candidate-acl" value="rfc1918.auto"/>
            <param name="apply-candidate-acl" value="rfc6598.auto"/>
          </settings>
        </profile>
      </profiles>
    </configuration>
  </section>

  <!-- Users and routes come from fs-webrtc (mod_xml_curl); nothing is defined statically. -->
  <section name="dialplan" description="Regex/XML Dialplan"/>
  <section name="directory" description="User Directory"/>
</document>
