# Copy to .env and fill in (install.sh does this for you).
# fs-webrtc settings are also CLI flags: run `fs-webrtc --help`.

# --- Required -------------------------------------------------------------
# Domain people open in the browser. Point its DNS A record at this server and open TCP 80/443;
# Caddy then gets a Let's Encrypt certificate. An IP address works too (self-signed certificate).
FSW_DOMAIN=
# Shared secret between fs-webrtc and FreeSWITCH:  openssl rand -hex 32
FSW_FREESWITCH_SECRET=

# --- Accounts -------------------------------------------------------------
# Anyone who can open the site can create an account. Set false once everyone has joined.
FSW_SIGNUP=true
# Optional: require this code to create an account (share it with family and friends).
FSW_INVITE_CODE=

# --- Media / NAT ----------------------------------------------------------
# Public IP FreeSWITCH announces for audio/video. Empty = discover it with STUN.
# LAN-only setup? Put the server's LAN IP here.
FSW_EXT_IP=
# STUN/TURN servers for browsers, comma-separated.
FSW_ICE_SERVERS=stun:stun.l.google.com:19302

# --- Advanced -------------------------------------------------------------
# Image tag to run, e.g. 1.0.0 (default: latest)
FSW_VERSION=
FSW_LOG_JSON=true
RUST_LOG=info
